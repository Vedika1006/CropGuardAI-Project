PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers > Node.js)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cropguard?retryWrites=true&w=majority

# Any long random string works — used to sign JWTs
JWT_SECRET=replace_with_a_long_random_string

# URL of the Python FastAPI ML service's /predict/ endpoint.
# Use your machine's LAN IP (not localhost) if the phone/emulator needs to reach it,
# e.g. http://192.168.1.42:10000/predict/
LOCAL_AI_URL=http://localhost:10000/predict/
